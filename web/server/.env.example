# ========================================
# CẤU HÌNH NODE.JS BACKEND SMART LOCKER
# ========================================
PORT=3000

# Cấu hình Cơ sở dữ liệu MySQL (Mặc định Laragon)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_locker_db
DB_CONNECTION_LIMIT=10

# Cấu hình MQTT Broker (Giao tiếp với ESP32 Control)
MQTT_BROKER_URL=mqtt://broker.emqx.io:1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_TOPIC_CMD=SMART_LOCKER/LOCKER/CMD
MQTT_TOPIC_STATE=SMART_LOCKER/LOCKER/STATE
MQTT_TOPIC_ACK=SMART_LOCKER/LOCKER/ACK
MQTT_TOPIC_STATUS=SMART_LOCKER/ESP32/STATUS

# Cấu hình kết nối Python AI FastAPI Server
AI_SERVER_URL=http://127.0.0.1:8000
